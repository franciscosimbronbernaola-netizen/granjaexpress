# =====================================================================
# Copia este archivo a .env y completa los datos de TU proyecto Supabase.
# .env NUNCA se sube a GitHub (está en .gitignore).
#
# Supabase > Project Settings > Database > Connection string > URI
#  - DATABASE_URL: "Transaction pooler" (puerto 6543). Funciona por IPv4 desde Cloud Shell.
#  - BACKUP_DATABASE_URL: "Session pooler" (puerto 5432). Lo usa pg_dump para respaldos.
# Si la contraseña tiene caracteres especiales (@ # / ?), codifícalos (ej. @ = %40).
# =====================================================================
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
BACKUP_DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
